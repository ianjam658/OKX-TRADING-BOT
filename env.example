# Copy this file to .env for local development.
# NEVER commit the real .env file -- it's already in .gitignore.

# Exchange
EXCHANGE_ID=okx
API_KEY=
API_SECRET=
API_PASSPHRASE=
SANDBOX_MODE=true

# Trading
SYMBOL=BTC/USDT
TIMEFRAME=15m
FAST_MA=9
SLOW_MA=21
POLL_INTERVAL_SECONDS=60

# Survival economics
STARTING_BALANCE_USD=20
MIN_TRADE_USD=5
MAX_RISK_PER_TRADE_PCT=0.25
CRITICAL_BALANCE_PCT=0.25
DEATH_BALANCE_USD=1

# Safety switch -- keep true until you've fully tested on sandbox
DRY_RUN=true

# Optional LLM layer (Groq) -- OFF by default. Sentiment can only
# veto a trade the strategy already wanted to make; it never invents
# one. Narration is pure flavor text with zero effect on trading.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
USE_LLM_SENTIMENT=false
USE_LLM_NARRATION=false
